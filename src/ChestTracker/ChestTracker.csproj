<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- WinExe: no console window. The program shows itself with an icon next to the clock
         (TrayIcon.cs) and its interface is the dashboard in the browser.
         Windows Forms, which the tray icon uses, needs the -windows framework. -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>FortniteChestCounter</AssemblyName>
    <Product>Fortnite Chest Counter</Product>
    <Version>0.0.0-dev</Version>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <RootNamespace>ChestTracker</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <ServerGarbageCollection>false</ServerGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <!-- The whole interface is one HTML file shipped inside the executable -->
    <EmbeddedResource Include="ui\index.html" LogicalName="index.html" />
    <!-- The same icon the tray reads at run time, whether it runs as an .exe or through "dotnet" -->
    <EmbeddedResource Include="icon.ico" LogicalName="icon.ico" />
  </ItemGroup>

  <!-- Written in by the release workflow; a build without it never updates itself -->
  <ItemGroup Condition="'$(UpdateRepository)' != ''">
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>UpdateRepository</_Parameter1>
      <_Parameter2>$(UpdateRepository)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\vendor\FortniteReplayDecompressor\src\FortniteReplayReader\FortniteReplayReader.csproj" />
  </ItemGroup>

  <!-- The tests read the Save the World alert page's parse. That page is somebody else's HTML and
       its shape is the only thing that can break the alerts, so it is worth reaching into. -->
  <ItemGroup>
    <InternalsVisibleTo Include="ChestTracker.Tests" />
  </ItemGroup>

  <!--
    The published .exe has to carry .NET inside it. Nobody downloading it should have to install
    anything, and this is the only place that can be guaranteed: if the runtime were missing,
    the program would never get far enough to say so, because saying so is itself .NET code.
    A framework-dependent publish would hand that job to Microsoft's launcher instead of us.
    So a release that forgot the self-contained flag fails here rather than reaching anybody.
  -->
  <Target Name="EnsureSelfContained" BeforeTargets="PrepareForPublish" Condition="'$(PublishSingleFile)' == 'true'">
    <Error Condition="'$(SelfContained)' != 'true'"
           Text="La publicación tiene que ser --self-contained: si no, el .exe exige que el usuario instale .NET y nosotros no podemos ni avisarle. Añade --self-contained true." />
  </Target>

</Project>
